{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Anonymizer",
  "version": "0.1.0",
  "identifier": "fr.traiteur-gpt.anonymizer",
  "build": {
    "frontendDist": "../frontend"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Anonymizer — Traiteur-GPT",
        "width": 1400,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self' tauri: 'unsafe-inline'; connect-src 'self' http://localhost:8765"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "externalBin": ["binaries/anonymizer-sidecar"]
  }
}
